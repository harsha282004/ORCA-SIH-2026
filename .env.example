ORCA_MODE=demo

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Phase 5: Orchestration ---

# Multi-turn session persistence (architecture.md §31) — Redis TTL, seconds.
SESSION_TTL_SECONDS=3600

POSTGRES_DB=orca
POSTGRES_USER=orca
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

# --- Phase 1: Data Foundation ---

# DEMO_BBOX — PROPOSED, awaiting confirmation (see docs/demo_region.md).
# Region is fixed by architecture.md §44 (Mangaluru-Udupi coastal
# Karnataka); this exact numeric box is Phase 1's proposal, not yet frozen.
DEMO_BBOX_MIN_LAT=12.70
DEMO_BBOX_MIN_LON=73.50
DEMO_BBOX_MAX_LAT=13.45
DEMO_BBOX_MAX_LON=75.05

# Open-Meteo — no API key required (architecture.md §14).
OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1/marine
HTTP_TIMEOUT_SECONDS=6.0

# Max staleness before the Temporal Validity Gate marks data STALE (minutes).
WEATHER_MAX_STALENESS_MINUTES=30
MARINE_MAX_STALENESS_MINUTES=30

# Where raw source responses are preserved, relative to the working directory.
DATA_RAW_DIR=data/raw
